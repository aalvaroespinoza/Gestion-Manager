// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantPlan {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  ADMIN
  SELLER
  MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PENDING
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CURRENT_ACCOUNT
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  domain        String?        @unique
  plan          TenantPlan     @default(FREE)
  status        TenantStatus   @default(ACTIVE)
  settings      Json?          // Stores TenantSettings (theme, currency, taxRate, address, etc.)

  users         User[]
  categories    Category[]
  products      Product[]
  clients       Client[]
  sales         Sale[]
  cashShifts    CashShift[]
  cashMovements CashMovement[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([domain])
}

model User {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String?
  name          String?
  role          UserRole       @default(SELLER)
  status        UserStatus     @default(ACTIVE)

  sales         Sale[]
  cashShifts    CashShift[]
  cashMovements CashMovement[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Category {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  dynamicFieldsConfig Json?     // Stores CategoryDynamicFieldsConfig (attributes schema per commercial vertical)

  products            Product[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  code             String?       // SKU / Internal code / Barcode
  name             String
  description      String?
  costPrice        Decimal       @default(0) @db.Decimal(12, 2)
  salePrice        Decimal       @db.Decimal(12, 2)
  currentStock     Decimal       @default(0) @db.Decimal(12, 2)
  minStock         Decimal       @default(0) @db.Decimal(12, 2)
  customAttributes Json?         // Stores ProductCustomAttributes (size, color, measurements, expiration, etc.)
  status           ProductStatus @default(ACTIVE)

  saleItems        SaleItem[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, code])
}

model Client {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  docType     String?  // DNI, RUT, RFC, PASSPORT, TAX_ID
  docNumber   String?
  name        String
  email       String?
  phone       String?
  address     String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  metadata    Json?    // Stores ClientMetadata

  sales       Sale[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, docNumber])
}

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  cashShiftId   String?
  cashShift     CashShift?    @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)

  invoiceNumber String        // Sequential receipt/invoice folio
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?

  items         SaleItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, clientId])
  @@index([tenantId, cashShiftId])
  @@index([tenantId, createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  customSpecs Json?    // Snapshot of custom specs / dynamic attributes at time of sale

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

model CashShift {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         CashShiftStatus @default(OPEN)
  initialAmount  Decimal         @db.Decimal(12, 2)
  expectedAmount Decimal?        @db.Decimal(12, 2)
  actualAmount   Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  notes          String?

  movements      CashMovement[]
  sales          Sale[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

model CashMovement {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@index([cashShiftId])
}
