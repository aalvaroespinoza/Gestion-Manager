# ==============================================================================
# Gestión Manager - Environment Variables Configuration
# ==============================================================================

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_manager?schema=public"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT / Authentication Secret (Minimum 32 characters for JOSE / HS256)
JWT_SECRET="super-secret-jwt-key-for-development-change-in-production-min-32-chars"
